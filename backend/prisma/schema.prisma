// Prisma schema for the 1Fi EMI Marketplace
// Run `npm run prisma:generate` after editing this file, and
// `npm run prisma:migrate` to create/apply a migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String
  brand       String
  mrp         Decimal  @db.Decimal(10, 2)
  basePrice   Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants Variant[]
  emiPlans EmiPlan[]

  @@index([brand])
}

model Variant {
  id        String  @id @default(uuid())
  productId String
  color     String
  storage   String
  imageUrl  String
  price     Decimal @db.Decimal(10, 2)
  stock     Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // A given color + storage combination must be unique per product
  @@unique([productId, color, storage])
  @@index([productId])
}

model EmiPlan {
  id             String  @id @default(uuid())
  productId      String
  tenureMonths   Int
  interestRate   Decimal @db.Decimal(5, 2)
  monthlyPayment Decimal @db.Decimal(10, 2)
  cashback       Decimal @db.Decimal(10, 2) @default(0)
  isActive       Boolean @default(true)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, tenureMonths])
  @@index([productId])
}
